{
  "type": "container",
  "ops": [
    {
      "id": "agent",
      "type": "container/run",
      "args": {
        "image": "zolldyck/nostra:latest",
        "expose": 3000,
        "volumes": [
          { "name": "nostra-data", "dest": "/app/data" }
        ],
        "env": {
          "OPENAI_API_KEY": "nosana",
          "OPENAI_API_URL": "https://4ksj3tve5bazqwkuyqdhwdpcar4yutcuxphwhckrdxmu.node.k8s.prd.nos.ci/v1",
          "MODEL_NAME": "Qwen/Qwen3.5-4B",
          "SERVER_PORT": "3000",
          "SOLANA_NETWORK": "devnet",
          "SQLITE_PATH": "/app/data/nostra.db",
          "NODE_ENV": "production",
          "TELEGRAM_BOT_TOKEN": "$TELEGRAM_BOT_TOKEN",
          "SOLANA_PRIVATE_KEY": "$SOLANA_PRIVATE_KEY",
          "ALCHEMY_RPC_URL": "$ALCHEMY_RPC_URL",
          "NOSANA_API_KEY": "$NOSANA_API_KEY"
        }
      }
    }
  ],
  "version": "0.1",
"meta": {
  "market": "nvidia-4090"
}
}
