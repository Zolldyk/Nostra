# =============================================================
# Nostra — Constitutional Financial Agent
# Nosana x ElizaOS Agent Challenge
# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# IMPORTANT: .env is in .gitignore — NEVER commit real credentials.

# -------------------------------------------------------------
# LLM Configuration — Qwen/Qwen3.5-4B via Nosana Inference Endpoint
# -------------------------------------------------------------
OPENAI_API_KEY=nosana
OPENAI_API_URL=https://4ksj3tve5bazqwkuyqdhwdpcar4yutcuxphwhckrdxmu.node.k8s.prd.nos.ci/v1
MODEL_NAME=Qwen/Qwen3.5-4B

# -------------------------------------------------------------
# Embedding Configuration — Qwen3-Embedding-0.6B via Nosana
# -------------------------------------------------------------
OPENAI_EMBEDDING_URL=https://4yiccatpyxx773jtewo5ccwhw1s2hezq5pehndb6fcfq.node.k8s.prd.nos.ci/v1
OPENAI_EMBEDDING_API_KEY=nosana
OPENAI_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
OPENAI_EMBEDDING_DIMENSIONS=1024

# -------------------------------------------------------------
# Agent Server Configuration
# -------------------------------------------------------------
SERVER_PORT=3000

# -------------------------------------------------------------
# Telegram Bot
# -------------------------------------------------------------
# Create a bot via @BotFather on Telegram.
# Inject at Nosana runtime — NEVER bake into the Docker image.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NostraBot

# -------------------------------------------------------------
# Solana Configuration
# -------------------------------------------------------------
# Base58-encoded keypair for Nostra's dedicated agent wallet.
# This is NOT the user's main holdings wallet.
# Injected at Nosana runtime — NEVER hardcoded, never logged.
SOLANA_PRIVATE_KEY=

# Network: devnet (default for this story) or mainnet-beta
SOLANA_NETWORK=devnet

# Dedicated Alchemy RPC endpoints by cluster.
# Paper mode always uses devnet, even if SOLANA_NETWORK=mainnet-beta.
ALCHEMY_RPC_URL_DEVNET=https://solana-devnet.g.alchemy.com/v2/YOUR_DEVNET_KEY
ALCHEMY_RPC_URL_MAINNET=https://solana-mainnet.g.alchemy.com/v2/YOUR_MAINNET_KEY

# -------------------------------------------------------------
# SQLite Database
# -------------------------------------------------------------
# Must match the Nosana volume mount destination (/app/data).
# See nos_job_def/nosana_eliza_job_definition.json for volume config.
SQLITE_PATH=/app/data/nostra.db

# -------------------------------------------------------------
# Nosana API 
# -------------------------------------------------------------
NOSANA_API_KEY=
