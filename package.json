{
  "name": "nostra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "start": "elizaos start",
    "dev": "elizaos dev --character ./characters/agent.character.json",
    "demo": "bun run inference-proxy.ts & sleep 2 && elizaos dev --character ./characters/agent.character.json",
    "build": "tsc",
    "test": "bun test --path-ignore-patterns dist/"
  },
  "dependencies": {
    "@elizaos/core": "^1.0.0",
    "@elizaos/plugin-bootstrap": "^1.0.0",
    "@elizaos/plugin-openai": "^1.0.0",
    "@elizaos/plugin-sql": "^1.0.0",
    "@elizaos/plugin-telegram": "^1.0.0",
    "@solana/web3.js": "^1.98.0",
    "better-sqlite3": "^12.8.0",
    "bs58": "^6.0.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@elizaos/cli": "^1.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node-cron": "^3.0.11",
    "bun-types": "^1.3.11",
    "typescript": "^5.0.0"
  }
}
